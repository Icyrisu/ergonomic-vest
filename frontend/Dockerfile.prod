# ===================================================
# Stage 1: Build Frontend (Node.js)
# ===================================================
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependency specifications
COPY package*.json ./

# Install all dependencies (termasuk devDependencies untuk build Vite)
RUN npm install

# Copy seluruh source code frontend
COPY . .

# Pastikan VITE_BACKEND_URL kosong agar menggunakan relative path (/api dan /socket.io) via Nginx
ENV VITE_BACKEND_URL=""

# Build file statis React ke direktori /app/dist
RUN npm run build

# ===================================================
# Stage 2: Web Server Ringan (Nginx Alpine)
# ===================================================
FROM nginx:alpine

# Hapus konfigurasi default bawaan Nginx
RUN rm -rf /etc/nginx/conf.d/default.conf

# Salin hasil build dari stage 1 ke direktori web root Nginx
COPY --from=builder /app/dist /usr/share/nginx/html

# Salin konfigurasi Nginx reverse proxy
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Port 80 untuk HTTP
EXPOSE 80

# Jalankan Nginx di foreground
CMD ["nginx", "-g", "daemon off;"]
