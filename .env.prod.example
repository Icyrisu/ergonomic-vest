# ===================================================
# KONFIGURASI PRODUCTION VPS (Ergonomic Vest Dashboard)
# ===================================================

# 1. Konfigurasi Database PostgreSQL
POSTGRES_USER=admin
# Ganti dengan password yang kuat dan unik (hindari spasi)
POSTGRES_PASSWORD=GantiDenganPasswordRahasia_EV2026!
POSTGRES_DB=ergonomic_vest
DATABASE_PORT=5432

# 2. Konfigurasi Backend & MQTT Broker
BACKEND_PORT=3000
MQTT_BROKER=wss://broker.hivemq.com:8884/mqtt

# 3. Konfigurasi Frontend (Web Server Port)
# Port 80 adalah port HTTP standar web browser
FRONTEND_PORT=80
